# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Weights & Biases — get from https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=retinal-selective-prediction
WANDB_ENTITY=

# Kaggle — download kaggle.json from https://www.kaggle.com/settings
# Then either set these OR place kaggle.json at ~/.kaggle/kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=

# Where datasets live locally (Kaggle notebooks override this automatically)
DATA_ROOT=./data

# Reproducibility
GLOBAL_SEED=42
